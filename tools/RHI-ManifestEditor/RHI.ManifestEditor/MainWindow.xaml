<Window
    x:Class="RHI.ManifestEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RHI.ManifestEditor"
    xmlns:vm="using:RHI.ManifestEditor.ViewModels">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Button x:Name="OpenBtn" Content="📂 Open" Click="OpenBtn_Click"/>
            <Button x:Name="SaveBtn" Content="💾 Save" Click="SaveBtn_Click"/>
            <Button x:Name="SaveAsBtn" Content="Save As" Click="SaveAsBtn_Click"/>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Main content: Nav + Section editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav -->
            <NavigationView x:Name="NavView" Grid.Column="0"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Left"
                            SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Tag="search"     Icon="Find"  Content="🔍 Game Search"/>
                    <NavigationViewItemSeparator/>
                    <NavigationViewItem Tag="detection"  Content="📋 Detection"/>
                    <NavigationViewItem Tag="engine"     Content="⚙ Engine &amp; API"/>
                    <NavigationViewItem Tag="uehdr"      Content="🎮 UE/HDR"/>
                    <NavigationViewItem Tag="install"    Content="📦 Install"/>
                    <NavigationViewItem Tag="notes"      Content="📝 Notes"/>
                    <NavigationViewItem Tag="dxvk"       Content="🔷 DXVK"/>
                    <NavigationViewItem Tag="wikistatus" Content="✅ Wiki Status"/>
                    <NavigationViewItem Tag="authors"    Content="👤 Authors &amp; URLs"/>
                    <NavigationViewItem Tag="nvidia"     Content="🟢 NVIDIA/DLSS"/>
                    <NavigationViewItem Tag="doffix"     Content="🔧 DOF Fix"/>
                    <NavigationViewItem Tag="packs"      Content="🗂 Packs"/>
                </NavigationView.MenuItems>
            </NavigationView>

            <!-- Section frame -->
            <Frame x:Name="ContentFrame" Grid.Column="1"/>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}" Padding="12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ValidationText" Grid.Column="1" FontSize="12"
                       Foreground="OrangeRed" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

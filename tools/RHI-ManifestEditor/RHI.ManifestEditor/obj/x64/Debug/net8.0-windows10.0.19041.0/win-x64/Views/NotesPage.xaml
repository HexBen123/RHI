<Page
    x:Class="RHI.ManifestEditor.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Padding="16,16,16,8" Spacing="4">
            <TextBlock Text="Per-Game Content &amp; Notes" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Notes shown in each component's info button dialog. Select the component tab, then add/edit entries."/>
        </StackPanel>
        <TabView x:ConnectionId='2' x:Name="NotesTabView" Grid.Row="1" IsAddTabButtonVisible="False" TabWidthMode="Equal"
                                                            >
            <TabViewItem Header="RenoDX" Tag="gameNotes" IsClosable="False"/>
            <TabViewItem Header="ReShade" Tag="reshadeGameInfo" IsClosable="False"/>
            <TabViewItem Header="Luma (primary)" Tag="lumaGameInfo" IsClosable="False"/>
            <TabViewItem Header="Luma (notes)" Tag="lumaGameNotes" IsClosable="False"/>
            <TabViewItem Header="RE Framework" Tag="reframeworkGameInfo" IsClosable="False"/>
            <TabViewItem Header="ReLimiter" Tag="relimiterGameInfo" IsClosable="False"/>
            <TabViewItem Header="DC" Tag="displayCommanderGameInfo" IsClosable="False"/>
            <TabViewItem Header="OptiScaler" Tag="optiScalerGameInfo" IsClosable="False"/>
        </TabView>
        <Grid Grid.Row="2" Padding="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:ConnectionId='3' x:Name="NotesList" Grid.Row="0" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBox Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name" FontSize="12" MinWidth="240"/>
                            </Expander.Header>
                            <StackPanel Spacing="8" Padding="8">
                                <TextBlock Text="notes:" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Notes, Mode=TwoWay}" AcceptsReturn="True"
                                         MinHeight="80" MaxHeight="200" TextWrapping="Wrap" FontSize="12"/>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NotesUrl, Mode=TwoWay}" PlaceholderText="notesUrl (optional)" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding NotesUrlLabel, Mode=TwoWay}" PlaceholderText="notesUrlLabel (optional)" FontSize="12"/>
                                </Grid>
                                <Button x:ConnectionId='6' Content="Remove" Tag="{Binding}"                          Foreground="OrangeRed"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:ConnectionId='4' Grid.Row="1" Content="+ Add entry"                       Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Page>


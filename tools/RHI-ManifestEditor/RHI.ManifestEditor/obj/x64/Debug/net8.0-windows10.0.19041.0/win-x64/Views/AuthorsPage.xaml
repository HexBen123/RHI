<Page x:Class="RHI.ManifestEditor.Views.AuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="Authors &amp; External URLs" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Donation links, author display names, and URL overrides for Nexus/PCGW/UW Fix/Ultra+. All URL override keys use the detected game name."/>

        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="donationUrls — Ko-fi/donation links by author display name" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:ConnectionId='14' x:Name="DonationView" MaxHeight="200" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="display name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://ko-fi.com/..." FontSize="12"/>
                            <Button x:ConnectionId='17' Grid.Column="2" Content="✕" Tag="{Binding}"                              Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='15' Content="+ Add"                          />
            </StackPanel>
        </Expander>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="authorOverrides — force author for games with no wiki entry" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:ConnectionId='10' x:Name="AuthorOverridesView" MaxHeight="180" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="author name" FontSize="12"/>
                            <Button x:ConnectionId='13' Grid.Column="2" Content="✕" Tag="{Binding}"                                    Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='11' Content="+ Add"                                />
            </StackPanel>
        </Expander>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="nexusUrlOverrides / pcgwUrlOverrides / uwFixUrlOverrides / ultraPlusUrlOverrides" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="12" Padding="0,8,0,0">
                <TextBlock Text="nexusUrlOverrides" FontSize="12" FontWeight="SemiBold"/>
                <ListView x:ConnectionId='2' x:Name="NexusView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://nexusmods.com/..." FontSize="12"/>
                            <Button x:ConnectionId='9' Grid.Column="2" Content="✕" Tag="{Binding}"                           Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='3' Content="+ Add Nexus override"                       />
                <TextBlock Text="optiScalerWikiNames" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:ConnectionId='4' x:Name="OptiScalerWikiView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="RHI detected name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="OptiScaler wiki name" FontSize="12"/>
                            <Button x:ConnectionId='7' Grid.Column="2" Content="✕" Tag="{Binding}"                                    Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='5' Content="+ Add OptiScaler wiki name"                                />
            </StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</Page>


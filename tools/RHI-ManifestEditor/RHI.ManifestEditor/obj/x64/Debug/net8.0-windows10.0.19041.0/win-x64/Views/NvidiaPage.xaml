<Page x:Class="RHI.ManifestEditor.Views.NvidiaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="NVIDIA Profile &amp; DLSS" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="profileNameOverrides redirects a game to the correct NVIDIA driver profile. profileExeExclusions prevents false profile matches."/>
        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="profileNameOverrides — RHI name → NVIDIA driver profile name" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:ConnectionId='6' x:Name="ProfileNamesView" MaxHeight="200" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="RHI game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="NVIDIA profile name" FontSize="12"/>
                            <Button x:ConnectionId='9' Grid.Column="2" Content="✕" Tag="{Binding}"                                 Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='7' Content="+ Add"                             />
            </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="profileExeExclusions — exe names to skip in profile matching" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Added to the hardcoded exclusion list. Use to prevent false matches (e.g. launcher.exe)."/>
                <ListView x:ConnectionId='2' x:Name="ExeExclusionsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                            <Button x:ConnectionId='5' Grid.Column="1" Content="✕" Tag="{Binding}"                                  Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='3' Content="+ Add"                              />
            </StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</Page>


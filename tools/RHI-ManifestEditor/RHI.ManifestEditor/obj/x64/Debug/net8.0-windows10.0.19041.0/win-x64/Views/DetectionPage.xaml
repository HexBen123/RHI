<Page
    x:Class="RHI.ManifestEditor.Views.DetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20">
            <TextBlock Text="Game Detection" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Games to hide, unlink from the wiki, remap to correct mod names, or redirect to a subfolder."/>

            <!-- Blacklist -->
            <Expander IsExpanded="True" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="blacklist — hide these detected entries entirely" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="DLC packs, launchers, non-game store entries. Key = detected folder/app name."/>
                    <ListView x:ConnectionId='14' x:Name="BlacklistView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button x:ConnectionId='17' Grid.Column="1" Content="✕" Tag="{Binding}"
                                                                          Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:ConnectionId='15' Content="+ Add"                           />
                </StackPanel>
            </Expander>

            <!-- wikiUnlinks -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="wikiUnlinks — disconnect from wiki entirely" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Card shows but has no RenoDX row and no generic engine fallback. Use for deprecated mods or games with no mod."/>
                    <ListView x:ConnectionId='10' x:Name="WikiUnlinksView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button x:ConnectionId='13' Grid.Column="1" Content="✕" Tag="{Binding}"                                Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:ConnectionId='11' Content="+ Add"                            />
                </StackPanel>
            </Expander>

            <!-- wikiNameOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="wikiNameOverrides — detected name → wiki mod name" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = detected folder name. Value = exact name on the RenoDX wiki."/>
                    <ListView x:ConnectionId='6' x:Name="WikiNameOverridesView" MaxHeight="300" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="detected name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="wiki mod name" FontSize="12"/>
                                    <Button x:ConnectionId='9' Grid.Column="2" Content="✕" Tag="{Binding}"                                      Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:ConnectionId='7' Content="+ Add"                                  />
                </StackPanel>
            </Expander>

            <!-- installPathOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="installPathOverrides — subfolder where mods deploy" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = detected name. Value = relative subpath (e.g. bin\x64). Pipe-separate for multiple candidates."/>
                    <ListView x:ConnectionId='2' x:Name="InstallPathOverridesView" MaxHeight="300" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="subpath" FontSize="12"/>
                                    <Button x:ConnectionId='5' Grid.Column="2" Content="✕" Tag="{Binding}"                                         Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:ConnectionId='3' Content="+ Add"                                     />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>


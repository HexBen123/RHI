<Page x:Class="RHI.ManifestEditor.Views.DxvkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="DXVK" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Blacklist prevents the DXVK toggle. dxvkGameNotes shows in the DXVK info dialog."/>
        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="dxvkBlacklist — disable DXVK toggle (anti-cheat games)" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:ConnectionId='6' x:Name="BlacklistView" MaxHeight="220" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                            <Button x:ConnectionId='9' Grid.Column="1" Content="✕" Tag="{Binding}"                               Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='7' Content="+ Add"                           />
            </StackPanel>
        </Expander>
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="dxvkGameNotes — notes shown in DXVK info dialog" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:ConnectionId='2' x:Name="NotesView" MaxHeight="280" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch">
                            <Expander.Header><TextBox Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name" FontSize="12" MinWidth="200"/></Expander.Header>
                            <StackPanel Spacing="6" Padding="8">
                                <TextBox Text="{Binding Notes, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" FontSize="12"/>
                                <Button x:ConnectionId='5' Content="Remove" Tag="{Binding}"                          Foreground="OrangeRed"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button x:ConnectionId='3' Content="+ Add"                      />
            </StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</Page>


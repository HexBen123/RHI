<Page x:Class="RHI.ManifestEditor.Views.PacksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="Packs &amp; Component URLs" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="shaderPacks and addonPacks are complex structures best edited in the raw JSON for now. componentUrls overrides download URLs (keys: ueExtended, ueDofFix)."/>
        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="componentUrls — override download URLs for components" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Active keys: ueExtended (UE-Extended addon URL), ueDofFix (DOF Fix URL)."/>
                <ListView x:Name="ComponentUrlsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="key" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveComponentUrl_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddComponentUrl_Click"/>
            </StackPanel>
        </Expander>
        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
            Title="shaderPacks and addonPacks"
            Message="These fields have complex nested structures. Use the raw JSON in VS Code or your text editor for now. The manifest-field-reference.md doc has the full schema."/>
    </StackPanel></ScrollViewer>
</Page>

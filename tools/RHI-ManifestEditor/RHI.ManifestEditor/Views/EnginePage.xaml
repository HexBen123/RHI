<Page
    x:Class="RHI.ManifestEditor.Views.EnginePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20">
            <TextBlock Text="Engine &amp; Graphics API" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Override the auto-detected engine type, label, and graphics API. engineOverrides affects mod fallback logic. graphicsApiOverrides controls the API badge and ReShade DLL selection."/>

            <Expander IsExpanded="True" HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="engineOverrides — force engine type and label" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Special values: Unreal, Unreal (Legacy), Unity, RE Engine. Any other string = custom label shown in badge."/>
                    <ListView x:Name="EngineOverridesView" MaxHeight="300" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="engine label" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveEngineOverride_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddEngineOverride_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="engineHintOverrides — version hint string (display only)" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Sets card.EngineHint. Affects UE4 vs UE5 Engine.ini key decisions. Example value: Unreal Engine 5.3.2"/>
                    <ListView x:Name="EngineHintView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="e.g. Unreal Engine 5.3.2" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveEngineHint_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddEngineHint_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="graphicsApiOverrides — force API badge and ReShade DLL" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Tokens: DX8 DX9 DX10 DX11 DX12 Vulkan/VLK OpenGL/OGL. Comma-separate for dual-API (e.g. DX12, VLK)."/>
                    <ListView x:Name="GraphicsApiView" MaxHeight="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="e.g. DX12" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveGraphicsApi_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddGraphicsApi_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="thirtyTwoBitGames / sixtyFourBitGames — force bitness" FontWeight="SemiBold"/></Expander.Header>
                <Grid ColumnSpacing="16" Padding="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="32-bit games" FontSize="12" FontWeight="SemiBold"/>
                        <ListView x:Name="Bit32View" MaxHeight="200" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                        <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="Remove32Bit_Click" Padding="6,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="+ Add 32-bit" Click="Add32Bit_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="64-bit games" FontSize="12" FontWeight="SemiBold"/>
                        <ListView x:Name="Bit64View" MaxHeight="200" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                        <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="Remove64Bit_Click" Padding="6,4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="+ Add 64-bit" Click="Add64Bit_Click"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>

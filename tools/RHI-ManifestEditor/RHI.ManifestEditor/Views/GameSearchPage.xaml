<Page
    x:Class="RHI.ManifestEditor.Views.GameSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Game Search" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Text="Search by game name to see all manifest entries for that game."
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,28,0,0"/>

        <!-- Search box + results list -->
        <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Type a game name..."
                 TextChanged="SearchBox_TextChanged"/>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Name list -->
            <ListView x:Name="NameList" Grid.Column="0"
                      SelectionChanged="NameList_SelectionChanged"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding GameName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Entry list -->
            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="EntryPanel" Spacing="8"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

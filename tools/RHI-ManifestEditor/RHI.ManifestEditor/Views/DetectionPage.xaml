<Page
    x:Class="RHI.ManifestEditor.Views.DetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20">
            <TextBlock Text="Game Detection" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Games to hide, unlink from the wiki, remap to correct mod names, or redirect to a subfolder."/>

            <!-- Blacklist -->
            <Expander IsExpanded="True" HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="blacklist — hide these detected entries entirely" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="DLC packs, launchers, non-game store entries. Key = detected folder/app name."/>
                    <ListView x:Name="BlacklistView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}"
                                            Click="RemoveBlacklist_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddBlacklist_Click"/>
                </StackPanel>
            </Expander>

            <!-- wikiUnlinks -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="wikiUnlinks — disconnect from wiki entirely" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Card shows but has no RenoDX row and no generic engine fallback. Use for deprecated mods or games with no mod."/>
                    <ListView x:Name="WikiUnlinksView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveWikiUnlink_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddWikiUnlink_Click"/>
                </StackPanel>
            </Expander>

            <!-- wikiNameOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="wikiNameOverrides — detected name → wiki mod name" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = detected folder name. Value = exact name on the RenoDX wiki."/>
                    <ListView x:Name="WikiNameOverridesView" MaxHeight="300" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="detected name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="wiki mod name" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveWikiNameOverride_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddWikiNameOverride_Click"/>
                </StackPanel>
            </Expander>

            <!-- installPathOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="installPathOverrides — subfolder where mods deploy" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = detected name. Value = relative subpath (e.g. bin\x64). Pipe-separate for multiple candidates."/>
                    <ListView x:Name="InstallPathOverridesView" MaxHeight="300" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="subpath" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveInstallPathOverride_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddInstallPathOverride_Click"/>
                </StackPanel>
            </Expander>

            <!-- splitGames -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="splitGames — split one store entry into multiple cards" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Use when one game folder contains multiple games in subfolders (e.g. LISA, Mass Effect Legendary Edition). Each sub-game gets its own card."/>
                    <ListView x:Name="SplitGamesView" MaxHeight="500" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBox Text="{Binding DetectedName, Mode=TwoWay}"
                                                 PlaceholderText="detected folder name (e.g. LISA)"
                                                 FontSize="12" MinWidth="260"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Padding="8">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Name = display name for the card. Subpath = relative path from the detected folder."/>
                                        <ListView ItemsSource="{Binding SubGames}" MaxHeight="200" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}"
                                                                 PlaceholderText="card name" FontSize="12"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SubPath, Mode=TwoWay}"
                                                                 PlaceholderText="subpath (or empty)" FontSize="12"/>
                                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}"
                                                                Click="RemoveSubGame_Click" Padding="8,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="+ Add sub-game" Tag="{Binding}" Click="AddSubGame_Click"/>
                                            <Button Content="Remove split" Tag="{Binding}" Click="RemoveSplitGame_Click" Foreground="OrangeRed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add split game" Click="AddSplitGame_Click"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
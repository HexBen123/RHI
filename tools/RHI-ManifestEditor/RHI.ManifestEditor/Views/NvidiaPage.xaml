<Page x:Class="RHI.ManifestEditor.Views.NvidiaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="NVIDIA Profile &amp; DLSS" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="profileNameOverrides redirects a game to the correct NVIDIA driver profile. profileExeExclusions prevents false profile matches."/>

        <!-- featureFlags -->
        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="featureFlags — remotely enable dev-gated features for all users" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="8" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="When true, the feature is visible to all users without needing unlock.txt. Push manifest.json to release a feature."/>
                <CheckBox x:Name="FeatureFlagDlssNrBox" Content="dlssNr — DLSS Neural Rendering column" Checked="FeatureFlag_Changed" Unchecked="FeatureFlag_Changed"/>
                <CheckBox x:Name="FeatureFlagNexusModsBox" Content="nexusMods — Nexus Mods integration" Checked="FeatureFlag_Changed" Unchecked="FeatureFlag_Changed"/>
                <CheckBox x:Name="FeatureFlagResolutionControlBox" Content="resolutionControl — resolution auto-toggle on game launch" Checked="FeatureFlag_Changed" Unchecked="FeatureFlag_Changed"/>
            </StackPanel>
        </Expander>

        <!-- rtxHdrInfoUrl -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="rtxHdrInfoUrl — global info link for the RTX HDR info button" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="6" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="URL opened when the user clicks the info button in the RTX HDR Configure dialog. Falls back to a hardcoded Reddit post if empty."/>
                <TextBox x:Name="RtxHdrInfoUrlBox" PlaceholderText="https://..." FontSize="12"
                         TextChanged="RtxHdrInfoUrl_TextChanged"/>
            </StackPanel>
        </Expander>

        <!-- profileNameOverrides -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="profileNameOverrides — RHI name → NVIDIA driver profile name" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:Name="ProfileNamesView" MaxHeight="200" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="RHI game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="NVIDIA profile name" FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveProfileName_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddProfileName_Click"/>
            </StackPanel>
        </Expander>

        <!-- profileExeExclusions -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="profileExeExclusions — exe names to skip in profile matching" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Added to the hardcoded exclusion list. Use to prevent false matches (e.g. launcher.exe)."/>
                <ListView x:Name="ExeExclusionsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                            <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveExeExclusion_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddExeExclusion_Click"/>
            </StackPanel>
        </Expander>

        <!-- dlssPresets -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="dlssPresets — add new DLSS preset options (SR/RR/FG/NR)" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="12" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Adds new presets to the SR/RR/FG/NR dropdowns. name = display label (e.g. F - CNN). value = integer ID. disabled=true removes an existing preset."/>

                <TextBlock Text="SR (Super Resolution)" FontSize="12" FontWeight="SemiBold"/>
                <ListView x:Name="SrPresetsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveSrPreset_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add SR preset" Click="AddSrPreset_Click"/>

                <TextBlock Text="RR (Ray Reconstruction)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="RrPresetsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveRrPreset_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add RR preset" Click="AddRrPreset_Click"/>

                <TextBlock Text="FG (Frame Generation)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="FgPresetsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveFgPreset_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add FG preset" Click="AddFgPreset_Click"/>

                <TextBlock Text="NR (Neural Rendering)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="NrPresetsView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveNrPreset_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add NR preset" Click="AddNrPreset_Click"/>
            </StackPanel>
        </Expander>

        <!-- dlssPresetsDev -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="dlssPresetsDev — dev-only DLSS preset options (SR/RR/FG/NR)" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="12" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Only visible when unlock.txt is present in %LocalAppData%\RHI\. Same structure as dlssPresets — entries prepended to the top of each dropdown."/>

                <TextBlock Text="SR (Super Resolution)" FontSize="12" FontWeight="SemiBold"/>
                <ListView x:Name="SrPresetsDevView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveSrPresetDev_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add SR dev preset" Click="AddSrPresetDev_Click"/>

                <TextBlock Text="RR (Ray Reconstruction)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="RrPresetsDevView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveRrPresetDev_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add RR dev preset" Click="AddRrPresetDev_Click"/>

                <TextBlock Text="FG (Frame Generation)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="FgPresetsDevView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveFgPresetDev_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add FG dev preset" Click="AddFgPresetDev_Click"/>

                <TextBlock Text="NR (Neural Rendering)" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="NrPresetsDevView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                            <CheckBox Grid.Column="2" Content="disabled" IsChecked="{Binding Disabled, Mode=TwoWay}" FontSize="11"/>
                            <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveNrPresetDev_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add NR dev preset" Click="AddNrPresetDev_Click"/>
            </StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</Page>

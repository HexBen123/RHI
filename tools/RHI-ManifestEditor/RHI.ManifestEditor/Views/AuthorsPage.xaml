<Page x:Class="RHI.ManifestEditor.Views.AuthorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="Authors &amp; External URLs" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Donation links, author display names, and URL overrides for Nexus/PCGW/UW Fix/Ultra+. All URL override keys use the detected game name."/>

        <!-- pcgw settings -->
        <Expander IsExpanded="True" HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="PCGamingWiki settings — URL resolution method and cache control" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="8" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="pcgwUseAppId: when true, use appid.php endpoint (broken Aug 2026, may be restored). When false, use OpenSearch API. Bump pcgwUrlCacheVersion to force all clients to wipe their URL cache."/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch x:Name="PcgwUseAppIdToggle" Header="pcgwUseAppId" Toggled="PcgwUseAppId_Toggled" MinWidth="0"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="pcgwUrlCacheVersion" FontSize="12"/>
                        <TextBox x:Name="PcgwUrlCacheVersionBox" PlaceholderText="0" FontSize="12" Width="80"
                                 TextChanged="PcgwUrlCacheVersion_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- authorDisplayNames -->
        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="authorDisplayNames — wiki author handle → display name" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Key = wiki author handle (e.g. PotatoOfDoom1337). Value = display name shown in RHI (e.g. PotatoOfDoom)."/>
                <ListView x:Name="AuthorDisplayNamesView" MaxHeight="200" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="wiki handle" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="display name" FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveAuthorDisplayName_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddAuthorDisplayName_Click"/>
            </StackPanel>
        </Expander>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="donationUrls — Ko-fi/donation links by author display name" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:Name="DonationView" MaxHeight="200" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="display name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://ko-fi.com/..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveDonation_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddDonation_Click"/>
            </StackPanel>
        </Expander>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="authorOverrides — force author for games with no wiki entry" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="4" Padding="0,8,0,0">
                <ListView x:Name="AuthorOverridesView" MaxHeight="180" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="author name" FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveAuthorOverride_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddAuthorOverride_Click"/>
            </StackPanel>
        </Expander>

        <Expander HorizontalAlignment="Stretch">
            <Expander.Header><TextBlock Text="nexusUrlOverrides / pcgwUrlOverrides / uwFixUrlOverrides / ultraPlusUrlOverrides" FontWeight="SemiBold"/></Expander.Header>
            <StackPanel Spacing="12" Padding="0,8,0,0">
                <TextBlock Text="nexusUrlOverrides" FontSize="12" FontWeight="SemiBold"/>
                <ListView x:Name="NexusView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://nexusmods.com/..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveNexus_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add Nexus override" Click="AddNexus_Click"/>

                <TextBlock Text="pcgwUrlOverrides" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="PcgwView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://pcgamingwiki.com/..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemovePcgw_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add PCGW override" Click="AddPcgw_Click"/>

                <TextBlock Text="uwFixUrlOverrides" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="UwFixView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveUwFix_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add UW Fix override" Click="AddUwFix_Click"/>

                <TextBlock Text="ultraPlusUrlOverrides" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="UltraPlusView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://theultraplace.com/..." FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveUltraPlus_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add Ultra+ override" Click="AddUltraPlus_Click"/>

                <TextBlock Text="optiScalerWikiNames" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ListView x:Name="OptiScalerWikiView" MaxHeight="160" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="RHI detected name" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="OptiScaler wiki name" FontSize="12"/>
                            <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveOptiScalerWiki_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add OptiScaler wiki name" Click="AddOptiScalerWiki_Click"/>
            </StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</Page>

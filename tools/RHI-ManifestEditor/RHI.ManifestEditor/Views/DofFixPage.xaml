<Page x:Class="RHI.ManifestEditor.Views.DofFixPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="DOF Fix" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="dofFixForceGames enables DOF Fix for games where UE engine detection fails. dofFixSkipGames suppresses it."/>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="dofFixForceGames" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Enable DOF Fix even without UE detection. 64-bit requirement still applies."/>
                <ListView x:Name="ForceView" MaxHeight="300" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                            <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveForce_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddForce_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="dofFixSkipGames" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Suppress DOF Fix for games where it causes problems."/>
                <ListView x:Name="SkipView" MaxHeight="300" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                            <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveSkip_Click" Padding="8,4"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Button Content="+ Add" Click="AddSkip_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel></ScrollViewer>
</Page>

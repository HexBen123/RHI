<Page x:Class="RHI.ManifestEditor.Views.WikiStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16"><StackPanel Spacing="20">
        <TextBlock Text="Wiki Status Overrides" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Patches the status emoji on wiki mod entries without a wiki edit. Key = exact mod name on the wiki. Values: ✅ 🚧 ⚠️"/>
        <ListView x:Name="ListView" MaxHeight="500" SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate>
                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="wiki mod name" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="✅" FontSize="12"/>
                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="Remove_Click" Padding="8,4"/>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
        <Button Content="+ Add" Click="Add_Click"/>
    </StackPanel></ScrollViewer>
</Page>
